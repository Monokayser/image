<w:p><w:pPr><w:spacing w:before="0" w:after="180"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:t xml:space="preserve">8. CI/CD and Automation</w:t></w:r></w:p>
